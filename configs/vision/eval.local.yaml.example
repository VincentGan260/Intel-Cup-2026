# 个人本地覆盖示例（测试配置）。
# 用法：复制为 eval.local.yaml（去掉 .example），只写你要改的项，其余沿用 eval.yaml。
# 支持嵌套覆盖——只改某一项不必重写整块。eval.local.yaml 不进 git。
#
# 例 1：你的 BDD 在别的盘、只想先跑 30 张
# detection:
#   images_dir: E:/datasets/bdd100k/images/100k/val
#   labels_dir: E:/datasets/bdd100k/labels/100k/val
#   num_samples: 30
#
# 例 2：你的 Cityscapes 路径不同
# segmentation:
#   datasets:
#     - name: cityscapes
#       images_dir: E:/datasets/cityscapes/leftImg8bit/val
#       labels_dir: E:/datasets/cityscapes/gtFine/val
#       label_suffix: _gtFine_labelIds.png
#       image_suffix: _leftImg8bit.png
#       road_value: 7
#       ignore_value: 255
#       recursive: true
